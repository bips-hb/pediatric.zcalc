Package: pediatric.zcalc
Type: Package
Title: Z-Score Calculator for Clinical Parameters in Biomarkers in Children, Adolescents, and Young Adults
Version: 0.1.0
Authors@R: c(
    person(
      "Andreas", "Mändle",
      email = "maendle@leibniz-bips.de",
